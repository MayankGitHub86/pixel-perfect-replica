# Recruitment Automation Platform - Environment Variables Template
# Copy this file to .env and adjust values for local development.

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Public backend URL for Excel hyperlinks and external references.
# In development, this defaults to http://localhost:3000 if empty.
# In production, set this to your deployed HTTPS domain:
# BACKEND_PUBLIC_URL=https://api.recruitflow.example.com
BACKEND_PUBLIC_URL=

# Database Configuration (PostgreSQL)
# Local host connection (for running backend locally outside docker):
DATABASE_URL=postgresql://postgres:password@localhost:5432/recruitment
# Inside Docker Compose: postgresql://postgres:password@postgres:5432/recruitment

# Redis Configuration (BullMQ & Cache)
# Local host connection:
REDIS_URL=redis://localhost:6379
# Inside Docker Compose: redis://redis:6379

# Microsoft Identity / Graph OAuth (Phase 3 placeholders)
MICROSOFT_CLIENT_ID=your_client_id_here
MICROSOFT_CLIENT_SECRET=your_client_secret_here
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/integrations/microsoft/callback
TOKEN_ENCRYPTION_KEY=your_base64_32byte_aes_key_here

# Excel Integration (Phase 5 placeholders)
EXCEL_WORKBOOK_ID=your_workbook_id_here
EXCEL_TABLE_NAME=CandidateMaster


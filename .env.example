# Recruitment Automation Platform - Environment Variables Template
# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:3000

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Public backend URL for Excel hyperlinks and external references.
# In development, this defaults to http://localhost:3000 if empty.
# In production, set this to your deployed HTTPS domain:
# BACKEND_PUBLIC_URL=https://api.recruitflow.example.com
BACKEND_PUBLIC_URL=

# Port mappings on host (avoids conflicts if 5432/6379 are used by other local services)
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# Local host connection (for running backend on host machine):
DATABASE_URL=postgresql://postgres:password@localhost:5433/recruitment
REDIS_URL=redis://localhost:6380

# Container internal URLs (when backend runs inside docker):
# DATABASE_URL=postgresql://postgres:password@postgres:5432/recruitment
# REDIS_URL=redis://redis:6379

# Microsoft Identity / Graph OAuth (Phase 3 placeholders)
MICROSOFT_CLIENT_ID=placeholder_client_id
MICROSOFT_CLIENT_SECRET=placeholder_client_secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/integrations/microsoft/callback
TOKEN_ENCRYPTION_KEY=placeholder_base64_32byte_aes_key

# Excel Integration (Phase 5 placeholders)
EXCEL_WORKBOOK_ID=placeholder_workbook_id
EXCEL_TABLE_NAME=CandidateMaster
